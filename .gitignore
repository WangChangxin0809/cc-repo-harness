__pycache__/
*.pyc
.index/
.drift/
.consolidation/

# Personal permission grants. Committed, they apply to everyone who clones.
.claude/settings.local.json

# Corpus checkouts. Pinned in eval/corpus.json and fetched, never committed:
# nine of the twenty carry no licence, so redistributing them is not ours to do.
eval/.work/
# Scratch clones for eval/validate_defects.py: one per repository, each with
# its own venv. Rebuilt on demand, and holding a stranger's code besides.
eval/.defects/

# The agent under test is installed by `npm ci` from eval/agent/package-lock.json.
# The lockfile is the artefact worth keeping; the tree it expands to is not.
eval/agent/node_modules/

# Working copies made by eval/improve.py: a scaffolded-and-edited clone of
# somebody else's repository. The findings go in eval/results/; the trees are
# uploaded as a CI artefact when the run is one worth reading a diff from.
eval/.improve/

# Assessment pages and other throwaway output, kept in the tree only so a
# person can open them. Never committed: they are a snapshot of one machine on
# one day, and a stale one reads as current.
tmp/

# Environment files. Never committed: a value in one of these is a credential,
# and a credential that reaches a commit is in the history, in every clone and
# in every fork afterwards -- the fix for which is a rotation, not a revert.
# The `.example` twin is the thing to commit: the shape, with placeholders.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Claude Code agent worktrees: a checkout inside the checkout, which ruff and
# the gates must not read as this tree
.claude/worktrees/
